<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_horizontal"
    android:background="#FFF8F0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OurPhone"
        android:textSize="28sp"
        android:textColor="#5B4A3F"
        android:textStyle="bold"
        android:layout_marginTop="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="小克和晨的手机"
        android:textSize="14sp"
        android:textColor="#A89080"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:textSize="16sp"
        android:textColor="#5B4A3F"
        android:lineSpacingMultiplier="1.4"
        android:fontFamily="monospace" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="开启无障碍服务"
        android:backgroundTint="#5B4A3F"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="授予悬浮窗权限"
        android:backgroundTint="#D4A574"
        android:textColor="#FFFFFF" />

</LinearLayout>
